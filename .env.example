# Copy to .env (git-ignored). Never commit real secrets.
# MongoDB (dev: `deno task mongo:up` starts a local container on 127.0.0.1:27018)
DB_HOST=127.0.0.1
DB_PORT=27018
DB_NAME=dweb_admin
DB_USER=
DB_PASS=
DB_AUTH_SOURCE=admin

# Dev listen ports. Docker host publish defaults match unless overridden via HOST_PORT_*.
APP_HOST=127.0.0.1
APP_PORT_BACKEND=8810
APP_PORT_FRONTEND=8811
APP_PORT_MOBILE=8812
APP_PORT_API=8813
# HOST_PORT_BACKEND=8810
# HOST_PORT_FRONTEND=8811
# HOST_PORT_MOBILE=8812
# HOST_PORT_API=8813

# Auth session cookie (seconds). Set ADMIN_COOKIE_SECURE=1 behind HTTPS.
AUTH_COOKIE_NAME=dweb_admin_sid
AUTH_SESSION_MAX_AGE=86400
ADMIN_COOKIE_SECURE=0

# Default admin seeded on first start (admin / admin888). Override for production!
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin888

# Login/passkey attempts per 10 min per client (default 20; raised in dev for E2E)
# LOGIN_RATE_MAX=20
# Browser-facing api origin (admin /cs open returns this for wsUrl). FE/mobile guest uses same-origin /cs proxy.
# API_PUBLIC_BASE=http://127.0.0.1:8813

# WebChat upload / ClamAV (api) — virusScan via @dreamer/upload (uiViewUploadPlugin 透传)
# CS_UPLOAD_DIR=./uploads
# CLAMAV_ENABLE=1  (set 0 to disable virusScan)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# default required (omit or 1). Set 0 ONLY to degrade-allow when clamd down (dev escape hatch).
CLAMAV_REQUIRED=1
