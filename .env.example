# Copy to .env (git-ignored). Never commit real secrets.
# MongoDB (dev: `deno task mongo:up` starts a local container on 127.0.0.1:27018)
DB_HOST=127.0.0.1
DB_PORT=27018
DB_NAME=dweb_admin
DB_USER=
DB_PASS=
DB_AUTH_SOURCE=admin

# Backend HTTP
APP_HOST=127.0.0.1
APP_PORT_BACKEND=3100

# Auth session cookie (seconds). Set ADMIN_COOKIE_SECURE=1 behind HTTPS.
AUTH_COOKIE_NAME=dweb_admin_sid
AUTH_SESSION_MAX_AGE=86400
ADMIN_COOKIE_SECURE=0

# Default admin seeded on first start (admin / admin888). Override for production!
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin888

# Login/passkey attempts per 10 min per client (default 20; raised in dev for E2E)
# LOGIN_RATE_MAX=20
