{
  "version": "1.0.0",
  "tasks": {
    "dev": "deno run --env-file=.env -A backend/main.ts --dev",
    "dev:backend": "deno run --env-file=.env -A backend/main.ts --dev",
    "dev:frontend": "deno run --env-file=.env -A frontend/main.ts --dev",
    "dev:mobile": "deno run --env-file=.env -A mobile/main.ts --dev",
    "dev:api": "deno run --env-file=.env -A api/main.ts --dev",
    "seed": "deno run --env-file=.env -A scripts/seed.ts",
    "mongo:up": "docker compose -f docker-compose.dev.yml up -d mongo",
    "mongo:down": "docker compose -f docker-compose.dev.yml down",
    "test": "deno test --env-file=.env -A tests/",
    "build:backend": "deno run -A backend/main.ts --build",
    "build:frontend": "deno run -A frontend/main.ts --build",
    "build:mobile": "deno run -A mobile/main.ts --build",
    "build:api": "deno run -A api/main.ts --build",
    "start:backend": "deno run -A dist/backend/server.js --start",
    "start:frontend": "deno run -A dist/frontend/server.js --start",
    "start:mobile": "deno run -A dist/mobile/server.js --start",
    "start:api": "deno run -A dist/api/server.js --start",
    "run:hello": "echo Use: dweb-cli run hello/world -a console",
    "check": "deno check backend/main.ts frontend/main.ts mobile/main.ts api/main.ts console/main.ts",
    "fixture:mongo": "deno run --env-file=.env -A scripts/fixture-mongo.ts"
  },
  "imports": {
    "@common/": "./common/",
    "@backend/": "./backend/",
    "@frontend/": "./frontend/",
    "@mobile/": "./mobile/",
    "@api/": "./api/",
    "@console/": "./console/",
    "@dreamer/dweb": "../dweb/src/mod.ts",
    "@dreamer/render": "jsr:@dreamer/render@^1.5.3",
    "@dreamer/router": "jsr:@dreamer/router@^1.2.1",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.2.0",
    "@dreamer/view": "jsr:@dreamer/view@^3.0.4",
    "postcss": "npm:postcss@^8.5.32",
    "tailwindcss": "npm:tailwindcss@^4.3.5",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.3.5",
    "@dreamer/database": "jsr:@dreamer/database@^1.2.0",
    "@dreamer/theme": "jsr:@dreamer/theme@^1.1.0",
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@dreamer/middlewares": "jsr:@dreamer/middlewares@^1.1.0",
    "@dreamer/cache": "jsr:@dreamer/cache@^1.1.0",
    "@dreamer/humancheck": "jsr:@dreamer/humancheck@^1.1.0",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@^13.3.3",
    "exceljs": "npm:exceljs@4.4.0",
    "playwright": "npm:playwright@1.59.1",
    "@dreamer/websocket": "jsr:@dreamer/websocket@^1.1.0",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/ui-view": "../ui-view/src/mod.ts",
    "@dreamer/queue": "jsr:@dreamer/queue@^1.1.0",
    "@dreamer/storage": "jsr:@dreamer/storage@^1.1.0",
    "@dreamer/utils": "jsr:@dreamer/utils@^1.1.0",
    "qrcode": "npm:qrcode@1.5.4",
    "@dreamer/upload": "jsr:@dreamer/upload@^2.0.1",
    "@dreamer/upload/adapters": "jsr:@dreamer/upload@^2.0.1/adapters",
    "@dreamer/upload/server": "jsr:@dreamer/upload@^2.0.1/server",
    "@dreamer/upload/client": "jsr:@dreamer/upload@^2.0.1/client",
    "@dreamer/upload/scanner": "jsr:@dreamer/upload@^2.0.1/scanner",
    "@dreamer/image": "jsr:@dreamer/image@^1.1.0",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.1.0",
    "@dreamer/service": "jsr:@dreamer/service@^1.1.0",
    "@dreamer/ui-view/charts": "../ui-view/src/desktop/charts/mod.ts",
    "@dreamer/ui-view/feedback": "../ui-view/src/desktop/feedback/mod.ts",
    "@dreamer/ui-view/plugin": "../ui-view/plugin.ts",
    "@dreamer/ui-view/plugin/upload": "../ui-view/upload.ts"
  },
  "minimumDependencyAge": 0,
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view"
  },
  "exclude": [
    "runtime/",
    "dist/",
    "node_modules/"
  ]
}
