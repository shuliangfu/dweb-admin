{
  "version": "1.0.0",
  "tasks": {
    "dev": "deno run --env-file=.env -A backend/main.ts --dev",
    "dev:backend": "deno run --env-file=.env -A backend/main.ts --dev",
    "dev:frontend": "deno run -A frontend/main.ts --dev",
    "dev:mobile": "deno run -A mobile/main.ts --dev",
    "dev:api": "deno run -A api/main.ts --dev",
    "seed": "deno run --env-file=.env -A scripts/seed.ts",
    "mongo:up": "docker compose -f docker-compose.dev.yml up -d mongo",
    "mongo:down": "docker compose -f docker-compose.dev.yml down",
    "test": "deno test --env-file=.env -A tests/",
    "build:backend": "deno run -A backend/main.ts --build",
    "build:frontend": "deno run -A frontend/main.ts --build",
    "build:mobile": "deno run -A mobile/main.ts --build",
    "build:api": "deno run -A api/main.ts --build",
    "start:backend": "deno run -A dist/backend/server.js --start",
    "start:frontend": "deno run -A dist/frontend/server.js --start",
    "start:mobile": "deno run -A dist/mobile/server.js --start",
    "start:api": "deno run -A dist/api/server.js --start",
    "run:hello": "echo Use: dweb-cli run hello/world -a console"
  },
  "imports": {
    "@common/": "./common/",
    "@backend/": "./backend/",
    "@frontend/": "./frontend/",
    "@mobile/": "./mobile/",
    "@api/": "./api/",
    "@console/": "./console/",
    "@dreamer/dweb": "jsr:@dreamer/dweb@^3.7.6",
    "@dreamer/render": "jsr:@dreamer/render@^1.3.0",
    "@dreamer/router": "jsr:@dreamer/router@^1.2.1",
    "@dreamer/test": "jsr:@dreamer/test@^1.1.10",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.2.0",
    "@dreamer/view": "jsr:@dreamer/view@^2.2.0",
    "postcss": "npm:postcss@^8.5.10",
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.1.18",
    "@dreamer/database": "jsr:@dreamer/database@^1.2.0",
    "@dreamer/ui-view": "jsr:@dreamer/ui-view@^1.1.2",
    "@dreamer/ui-view/plugin": "jsr:@dreamer/ui-view@^1.1.2/plugin",
    "@dreamer/theme": "jsr:@dreamer/theme@^1.1.0",
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@dreamer/middlewares": "jsr:@dreamer/middlewares@^1.1.0",
    "@dreamer/utils/validator": "jsr:@dreamer/utils@^1.1.0/validator",
    "@dreamer/cache": "jsr:@dreamer/cache@^1.1.0",
    "@dreamer/humancheck": "jsr:@dreamer/humancheck@^1.1.0",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@^13.1.1",
    "exceljs": "npm:exceljs@4.4.0",
    "playwright": "npm:playwright@1.59.1",
    "@dreamer/ui-view/icons/": "../ui-view/src/shared/basic/icons/"
  },
  "minimumDependencyAge": 0,
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view"
  }
}
