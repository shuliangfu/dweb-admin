{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@common/*": ["./common/*"],
      "@backend/*": ["./backend/*"],
      "@frontend/*": ["./frontend/*"],
      "@mobile/*": ["./mobile/*"],
      "@api/*": ["./api/*"],
      "@console/*": ["./console/*"]
    },
    "baseUrl": "."
  },
  "include": ["tests/**/*", "common/**/*", "backend/**/*", "api/**/*"]
}
